// src/pages/c/[deviceId].astro
import Layout from '../../layouts/Layout.astro';
import { drizzle } from 'drizzle-orm/d1';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { devices, profiles } from '../../db/schema';

const { deviceId } = Astro.params;

if (!deviceId) {
  return Astro.redirect('/');
}

const db = drizzle(env.DB);

// 1. Look up the physical card by its ID
const deviceResult = await db.select().from(devices).where(eq(devices.id, deviceId)).limit(1);
const device = deviceResult[0];

// 2. If the card doesn't exist in our database at all, it's a fake/invalid card
if (!device) {
  return new Response("Tarjeta NFC inválida", { status: 404 });
}

// 3. If the card is real but UNCLAIMED (fresh out of the box)
if (!device.isClaimed) {
  return Astro.redirect(`/claim?id=${deviceId}`);
}

// 4. If the card IS claimed, find out which profile it's currently assigned to
if (device.profileId) {
  const profileResult = await db.select().from(profiles).where(eq(profiles.id, device.profileId)).limit(1);
  const targetProfile = profileResult[0];

  if (targetProfile) {
    // INVISIBLE REDIRECT: Send them instantly to the correct profile!
    return Astro.redirect(`/p/${targetProfile.username}`);
  }
}

// 5. Fallback: Claimed but no profile assigned yet
---

<Layout title="Tarjeta sin asignar | Hubi">
  <div class="min-h-screen bg-[#f7f9fe] text-slate-900 flex flex-col items-center justify-center p-4">
    <main class="w-full max-w-md bg-white rounded-3xl shadow-sm border border-slate-200 p-8 text-center">
      
      <!-- Sleeping Icon -->
      <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <span class="material-symbols-outlined text-3xl">nfc</span>
      </div>

      <h1 class="text-2xl font-bold text-slate-900 mb-2">La tarjeta está en reposo</h1>
      <p class="text-slate-600 mb-8 text-sm leading-relaxed">
        Esta tarjeta NFC de Hubi ha sido reclamada de forma segura, pero el propietario aún no la ha asignado a un perfil.
      </p>

      <div class="space-y-3">
        <a href="/login" class="block w-full bg-white border border-slate-200 text-slate-700 py-3.5 rounded-xl font-bold hover:bg-slate-50 transition-colors">
          ¿Eres el propietario? Inicia sesión para asignarla
        </a>
      </div>

    </main>
  </div>
</Layout>