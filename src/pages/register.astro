// src/pages/register.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Registro | Hubi">
  <div class="min-h-screen w-full flex items-center justify-center p-4">
    <main class="w-full max-w-[420px] bg-white rounded-2xl shadow-sm border border-[#e4bdba] p-6 sm:p-8 flex flex-col gap-6">
      
      <!-- Header -->
      <div class="flex flex-col items-center text-center gap-2">
        <div class="w-14 h-14 rounded-full bg-[#dc3135]/10 flex items-center justify-center mb-1">
          <span class="material-symbols-outlined text-[#b81120] text-3xl" style="font-variation-settings: 'FILL' 1;">person_add</span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-[#181c1f]">Crear Cuenta</h1>
        <p class="text-sm text-[#5b403e]">Configura tu perfil de Hubi</p>
      </div>

      <!-- Register Form -->
      <form id="register-form" class="flex flex-col gap-4">
        
        <div class="flex flex-col gap-1.5 text-left">
          <label class="text-xs font-semibold uppercase tracking-wider text-[#5b403e]" for="username">Nombre de usuario</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3 text-[#906f6d] text-xl pointer-events-none">alternate_email</span>
            <input 
              class="w-full bg-white border border-[#e4bdba] rounded-xl py-2.5 pl-10 pr-3 text-sm text-[#181c1f] placeholder:text-[#906f6d] focus:border-[#b81120] focus:ring-2 focus:ring-[#b81120]/15 outline-none transition-all" 
              id="username" 
              name="username" 
              placeholder="tunombre" 
              required 
              type="text"
              pattern="[a-zA-Z0-9_-]+"
              title="Solo se permiten letras, números, guiones bajos y guiones"
            />
          </div>
        </div>

        <div class="flex flex-col gap-1.5 text-left">
          <label class="text-xs font-semibold uppercase tracking-wider text-[#5b403e]" for="email">Correo Electrónico</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3 text-[#906f6d] text-xl pointer-events-none">mail</span>
            <input 
              class="w-full bg-white border border-[#e4bdba] rounded-xl py-2.5 pl-10 pr-3 text-sm text-[#181c1f] placeholder:text-[#906f6d] focus:border-[#b81120] focus:ring-2 focus:ring-[#b81120]/15 outline-none transition-all" 
              id="email" 
              name="email" 
              placeholder="tu@ejemplo.com" 
              required 
              type="email"
            />
          </div>
        </div>

        <div class="flex flex-col gap-1.5 text-left">
          <label class="text-xs font-semibold uppercase tracking-wider text-[#5b403e]" for="password">Contraseña</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3 text-[#906f6d] text-xl pointer-events-none">lock</span>
            <input 
              class="w-full bg-white border border-[#e4bdba] rounded-xl py-2.5 pl-10 pr-3 text-sm text-[#181c1f] placeholder:text-[#906f6d] focus:border-[#b81120] focus:ring-2 focus:ring-[#b81120]/15 outline-none transition-all" 
              id="password" 
              name="password" 
              placeholder="••••••••" 
              required 
              type="password"
              minlength="6"
            />
          </div>
        </div>

        <p id="error-message" class="text-xs font-semibold text-[#b81120] text-center hidden"></p>
        <p id="success-message" class="text-xs font-semibold text-green-600 text-center hidden">¡Cuenta creada! Redirigiendo al inicio de sesión...</p>

        <button 
          class="w-full bg-[#b81120] text-white rounded-xl py-3 px-4 text-sm font-semibold hover:opacity-95 active:scale-[0.99] transition-all flex items-center justify-center gap-2 shadow-sm mt-2 cursor-pointer" 
          type="submit"
        >
          <span>Registrarse</span>
          <span class="material-symbols-outlined text-lg">person_add</span>
        </button>

        <div class="text-center mt-2">
          <a href="/login" class="text-sm font-semibold text-[#5b403e] hover:text-[#b81120] transition-colors">¿Ya tienes una cuenta? Inicia sesión</a>
        </div>
      </form>

    </main>
  </div>
</Layout>

<script>
  const form = document.getElementById('register-form') as HTMLFormElement | null;
  const errorText = document.getElementById('error-message') as HTMLParagraphElement | null;
  const successText = document.getElementById('success-message') as HTMLParagraphElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Reset messages
    if (errorText) errorText.classList.add('hidden');
    if (successText) successText.classList.add('hidden');

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData);

    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        // Show success message and redirect after 1.5 seconds
        if (successText) successText.classList.remove('hidden');
        setTimeout(() => {
          const urlParams = new URLSearchParams(window.location.search);
          const redirectUrl = urlParams.get('redirect') || '/admin';
          window.location.href = redirectUrl;
        }, 1500);
      } else {
        const result = await res.json() as { error?: string };
        if (errorText) {
          errorText.textContent = result.error || 'El registro falló o el nombre de usuario ya está en uso.';
          errorText.classList.remove('hidden');
        }
      }
    } catch {
      if (errorText) {
        errorText.textContent = 'Error de conexión. Por favor, intenta de nuevo.';
        errorText.classList.remove('hidden');
      }
    }
  });
</script>