---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

<Layout title="Hubi | Gestión Inteligente de Enlaces NFC">
  <style>
    .nfc-pulse {
      animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.8); opacity: 0.5; }
      80% { transform: scale(1.5); opacity: 0; }
      100% { transform: scale(1.5); opacity: 0; }
    }
  </style>

  <div class="min-h-screen bg-[#f7f9fe] text-slate-900 flex flex-col justify-between antialiased selection:bg-[#b81120] selection:text-white">
    
    <!-- Navigation Header -->
    <header class="w-full max-w-[1200px] mx-auto h-20 px-6 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[#b81120] font-bold text-2xl">contactless</span>
        <span class="text-xl font-bold tracking-tight text-[#b81120]">Hubi</span>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="/login" 
          class="text-sm font-semibold text-slate-700 hover:text-slate-900 px-4 py-2 rounded-xl hover:bg-slate-100 transition-colors"
        >
          Iniciar sesión
        </a>
        <a 
          href="/register" 
          class="bg-[#b81120] text-white text-sm font-semibold px-4 py-2 rounded-xl hover:opacity-90 transition-opacity shadow-sm"
        >
          Comenzar
        </a>
      </div>
    </header>

    <!-- Hero Content -->
    <main class="flex-1 flex flex-col items-center justify-center px-6 py-12 text-center max-w-2xl mx-auto">
      
      <!-- NFC Badge -->
      <div class="inline-flex items-center gap-2 bg-red-50 border border-red-100 text-[#b81120] px-4 py-1.5 rounded-full text-xs font-bold mb-6">
        <div class="relative w-2 h-2 rounded-full bg-[#b81120]">
          <div class="absolute inset-0 rounded-full bg-[#b81120] nfc-pulse"></div>
        </div>
        Perfiles sin contacto de última generación
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        Comparte tu mundo con un solo <span class="text-[#b81120]">toque</span>.
      </h1>

      <p class="text-slate-600 text-base sm:text-lg mb-8 leading-relaxed max-w-lg">
        Crea tu micropágina personalizada, organiza tus enlaces clave y programa tus tarjetas NFC en segundos.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
        <a 
          href="/register" 
          class="bg-[#b81120] text-white px-8 py-3.5 rounded-xl font-semibold text-sm hover:opacity-90 shadow-md flex items-center justify-center gap-2 cursor-pointer transition-transform hover:scale-[1.02]"
        >
          <span class="material-symbols-outlined text-lg">bolt</span>
          Reclama tu usuario
        </a>
        <a 
          href="/login" 
          class="bg-white border border-slate-200 text-slate-700 px-8 py-3.5 rounded-xl font-semibold text-sm hover:bg-slate-50 shadow-sm flex items-center justify-center gap-2 cursor-pointer"
        >
          Acceder al Panel
        </a>
      </div>

    </main>

    <!-- Footer -->
    <footer class="w-full max-w-[1200px] mx-auto py-6 px-6 text-center text-xs text-slate-400 border-t border-slate-200/60">
      <p>© {new Date().getFullYear()} Hubi. Todos los derechos reservados.</p>
    </footer>

  </div>
</Layout>