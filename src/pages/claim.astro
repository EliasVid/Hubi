---
// src/pages/claim.astro
import Layout from '../layouts/Layout.astro';
import { drizzle } from 'drizzle-orm/d1';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { devices, sessions, profiles } from '../db/schema';

const deviceId = Astro.url.searchParams.get('id');
if (!deviceId) return Astro.redirect('/');

const db = drizzle(env.DB);
const deviceResult = await db.select().from(devices).where(eq(devices.id, deviceId)).limit(1);
const device = deviceResult[0];

if (!device) return new Response("Tarjeta inválida", { status: 404 });
if (device.isClaimed) return new Response("Esta tarjeta ya ha sido reclamada.", { status: 400 });

const sessionToken = Astro.cookies.get('nfc_hub_session')?.value;
let isLoggedIn = false;
let userProfiles: any[] = [];

if (sessionToken) {
  const sessionResult = await db.select().from(sessions).where(eq(sessions.tokenHash, sessionToken)).limit(1);
  if (sessionResult[0]) {
    isLoggedIn = true;
    userProfiles = await db.select().from(profiles).where(eq(profiles.userId, sessionResult[0].userId));
  }
}
---

<Layout title="Reclama tu Tarjeta NFC | Hubi">
  <div class="min-h-screen bg-[#f7f9fe] text-slate-900 flex flex-col items-center justify-center p-4">
    <main class="w-full max-w-md bg-white rounded-3xl shadow-sm border border-slate-200 p-8 text-center">
      
      <div class="w-16 h-16 bg-red-50 text-[#b81120] rounded-2xl flex items-center justify-center mx-auto mb-6">
        <span class="material-symbols-outlined text-3xl">contactless</span>
      </div>

      <h1 class="text-2xl font-bold text-slate-900 mb-2">¡Nueva Tarjeta Detectada!</h1>
      <p class="text-slate-600 mb-8 text-sm">Acabas de escanear una tarjeta NFC de Hubi no registrada. Reclámala para vincularla a tu cuenta.</p>

      {isLoggedIn && userProfiles.length > 0 ? (
        <div class="space-y-4">
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-6">
            <label class="block text-sm font-semibold text-slate-700 mb-2">Vincular esta tarjeta al perfil:</label>
            
            {/* CORRECCIÓN: Evitamos ternarios anidados separando la lógica con && */}
            {userProfiles.length === 1 && (
              <>
                <p class="text-[#b81120] font-bold text-lg">@{userProfiles[0].username}</p>
                <input type="hidden" id="claim-profile-id" value={userProfiles[0].id} />
              </>
            )}

            {userProfiles.length > 1 && (
              <select id="claim-profile-id" class="w-full bg-white border border-slate-300 text-slate-900 text-sm rounded-lg focus:ring-[#b81120] focus:border-[#b81120] block p-2.5 outline-none font-bold">
                {userProfiles.map(p => (
                  <option value={p.id}>@{p.username} {p.displayName ? '(' + p.displayName + ')' : ''}</option>
                ))}
              </select>
            )}
          </div>
          
          <button id="claim-btn" data-device={deviceId} class="w-full bg-[#b81120] text-white py-3.5 rounded-xl font-bold hover:opacity-90 transition-opacity flex justify-center items-center gap-2">
            Reclamar Tarjeta Ahora
          </button>
        </div>
      ) : (
        <div class="space-y-3">
          <p class="text-sm font-semibold text-amber-600 bg-amber-50 py-2 px-4 rounded-lg mb-4">Por favor, inicia sesión para reclamar esta tarjeta.</p>
          <a href="/login" class="block w-full bg-[#b81120] text-white py-3.5 rounded-xl font-bold hover:opacity-90 transition-opacity">Iniciar Sesión</a>
          <a href="/register" class="block w-full bg-white border border-slate-200 text-slate-700 py-3.5 rounded-xl font-bold hover:bg-slate-50 transition-colors">Crear una Cuenta</a>
        </div>
      )}

    </main>
  </div>
</Layout>

<script lang="ts">
  const claimBtn = document.getElementById('claim-btn') as HTMLButtonElement | null;
  const profileSelect = document.getElementById('claim-profile-id') as HTMLInputElement | HTMLSelectElement | null;
  
  claimBtn?.addEventListener('click', async (e) => {
    const target = e.currentTarget as HTMLButtonElement;
    const deviceId = target.dataset.device;
    const profileId = profileSelect?.value;

    if (!profileId) return alert('Selecciona un perfil primero.');
    
    target.disabled = true;
    target.innerHTML = 'Reclamando...';

    try {
      const res = await fetch('/api/claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ deviceId, profileId })
      });
      
      if (res.ok) {
        window.location.href = '/admin';
      } else { 
        alert('Error al reclamar la tarjeta.'); 
        target.disabled = false; 
        target.innerHTML = 'Reclamar Tarjeta Ahora'; 
      }
    } catch {
      alert('Error de red.'); 
      target.disabled = false; 
      target.innerHTML = 'Reclamar Tarjeta Ahora';
    }
  });
</script>